    "Location access is required for emergency calls. Please allow it in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a ubicación para llamadas de emergencia. Por favor, permítalo en Configuración."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急通話のために位置情報へのアクセスが必要です。設定で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급 호출을 위해 위치 접근 권한이 필요합니다. 설정에서 권한을 허용해주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧急呼叫需要位置访问权限。请在设置中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急呼叫需要位置訪問權限。請在設定中允許。"
          }
        }
      }
    },
