          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약관 및 정책"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条款与政策"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
