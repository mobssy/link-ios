    "⚠️ Deleted accounts cannot be recovered, and all conversations are permanently deleted." : {
      "comment" : "Explanation of the consequences of deleting an account.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Las cuentas eliminadas no se pueden recuperar y todas las conversaciones se eliminan permanentemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 削除されたアカウントは復元できず、すべての会話が完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 삭제된 계정은 복구할 수 없으며, 모든 대화 내용이 영구 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 已删除的账户无法恢复，所有对话将被永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 已刪除的帳戶無法恢復，所有對話將被永久刪除。"
          }
        }
      }
    },
