    "Privacy" : {
      "comment" : "Segment that shows the privacy policy",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacidad"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーポリシー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보처리방침"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私政策"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱私政策"
          }
        }
      }
    },
    "privacy.placeholder" : {
      "comment" : "Placeholder text of the privacy policy",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The privacy policy explains principles regarding collection, use, storage, and disposal of personal information to protect users.\nWe manage users' personal data securely and obtain clear consent before providing it to third parties.\nRights concerning personal information are protected by applicable laws."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La política de privacidad explica los principios de recopilación, uso, almacenamiento y eliminación de datos personales para proteger a los usuarios.\nGestionamos los datos personales de los usuarios de forma segura y obtenemos un consentimiento claro antes de compartirlos con terceros.\nLos derechos sobre los datos personales están protegidos por las leyes aplicables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーポリシーでは、ユーザーを保護するため、個人情報の収集・利用・保管・廃棄に関する方針を説明します。\n私たちはユーザーの個人データを安全に管理し、第三者に提供する前に明確な同意を得ます。\n個人情報に関する権利は、適用される法令によって保護されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보처리방침은 이용자의 개인정보 보호를 위해 수집, 이용, 보관, 파기에 관한 원칙을 설명합니다. 우리는 이용자의 개인정보를 안전하게 관리하며, 제3자 제공 시 명확한 동의를 받습니다. 개인정보와 관련된 권리는 관련 법령에 따라 보호됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私政策说明了为保护用户而收集、使用、存储和销毁个人信息的原则。\n我们会安全地管理用户的个人数据，并在向第三方提供前征得明确同意。\n与个人信息相关的权利受适用法律保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱私政策說明瞭為保護使用者而收集、使用、儲存和銷毀個人資訊的原則。\n我們會安全地管理使用者的個人資料，並在向第三方提供前徵得明確同意。\n與個人資訊相關的權利受適用法律保護。"
          }
        }
      }
    },
