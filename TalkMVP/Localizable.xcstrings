    "Long press a message and select 'Delete'. You can only delete your own messages." : {
      "comment" : "Text displayed in the settings screen to explain how to delete a message.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado un mensaje y selecciona 'Eliminar'. Solo puedes eliminar tus propios mensajes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを長押しして「削除」を選択してください。自分が送ったメッセージのみ削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 길게 눌러 '삭제'를 선택하세요. 자신이 보낸 메시지만 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按消息并选择「删除」。您只能删除自己发送的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按訊息並選擇「刪除」。您只能刪除自己發送的訊息。"
          }
        }
      }
    },
    "Long press a message to add emoji reactions." : {
      "localizations" : {
