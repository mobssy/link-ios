            "value" : "條款與政策"
          }
        }
      }
    },
    "terms.placeholder" : {
      "comment" : "Placeholder text of the terms of service",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These terms govern the conditions of service use. Users must understand and agree to these terms to use the service.\nThe terms detail the rights and obligations of the service provider and the responsibilities of the users.\nAll issues arising during the use of the service are governed by these terms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos términos regulan las condiciones de uso del servicio. Para usar el servicio, debes entender y aceptar estos términos.\nLos términos detallan los derechos y obligaciones del proveedor del servicio y las responsabilidades de los usuarios.\nTodas las cuestiones que surjan durante el uso del servicio se rigen por estos términos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本規約は、サービスの利用条件を定めるものです。ユーザーは本規約を理解し、同意したうえでサービスを利用するものとします。\n本規約は、サービス提供者の権利と義務、およびユーザーの責任と義務を詳しく定めています。\nサービスの利用中に生じたすべての問題は、本規約に従うものとします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본 약관은 서비스 이용에 관한 조건을 규정합니다. 사용자는 본 약관을 숙지하고 동의함으로써 서비스를 이용할 수 있습니다. 본 약관은 서비스 제공자의 권리와 의무, 이용자의 책임과 의무를 상세히 명시합니다. 서비스 이용 중 발생하는 모든 문제는 본 약관에 따릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本条款规定了服务的使用条件。用户须理解并同意本条款后方可使用本服务。\n本条款详细说明了服务提供者的权利与义务以及用户的责任与义务。\n使用服务过程中出现的所有问题均受本条款约束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本條款規定了服務的使用條件。使用者須理解並同意本條款後方可使用本服務。\n本條款詳細說明瞭服務提供者的權利與義務以及使用者的責任與義務。\n使用服務過程中出現的所有問題均受本條款約束。"
          }
        }
      }
    },
