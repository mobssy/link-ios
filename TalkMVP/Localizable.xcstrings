    "A message in another language shows its translation inside the bubble. Translation happens on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mensaje en otro idioma muestra su traducción dentro de la burbuja. La traducción se hace en este dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの言語で届いたメッセージは、吹き出しの中に翻訳が表示されます。翻訳はこのデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 언어로 온 메시지는 말풍선 안에 번역이 함께 보여요. 번역은 이 기기 안에서 이루어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他语言的消息会在气泡内显示译文。翻译在此设备上完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他語言的訊息會在氣泡內顯示譯文。翻譯在此裝置上完成。"
          }
        }
      }
    },
    "A reset link will be sent to your registered email." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se enviará un enlace de restablecimiento a tu correo registrado."
